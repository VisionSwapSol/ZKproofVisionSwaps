modules = ["nodejs-22"]
run = ["sh", "-c", "test -f web/dist/index.html || npm run build -w web; npm run start -w server"]

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "npm ci --include=dev && npm run build -w web"]
run = ["sh", "-c", "npm run start -w server"]

[[ports]]
localPort = 8787
externalPort = 80

[env]
HOST = "0.0.0.0"
PORT = "8787"
TRUST_PROXY_HOPS = "1"
