# The exact toolchain that builds vision_pool.so. program/scripts/build.sh reads
# this file and refuses to build with anything else. Change it only together
# with a new entry in program/RELEASES.json (see program/BUILD.md).
#
# These are the versions that built the program deployed on mainnet
# (sha256 2e6fb1f2..., executable hash 7edb5808...), reproduced byte for byte
# on 2026-10-14 from this repository with program/Cargo.lock.

# Agave CLI release that provides cargo-build-sbf (solana-cli 3.1.13, src:437252fc)
SOLANA_CLI_VERSION=3.1.13
# platform-tools passed to cargo-build-sbf --tools-version (rustc 1.89.0 for SBF)
PLATFORM_TOOLS_VERSION=v1.52
# SBPF target passed to cargo-build-sbf --arch (v0 = ELF e_flags 0)
SBPF_ARCH=v0
# Docker image for solana-verify (same CLI and platform-tools), pinned by digest
VERIFY_IMAGE=solanafoundation/solana-verifiable-build:3.1.13@sha256:1a0ea3dd15017e57e9b17d67267e7d2d7ab4f083499f3f29c847ddd54f01db31
