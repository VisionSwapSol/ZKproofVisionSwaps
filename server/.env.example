# VisionSwap server settings. Names only here; never commit real values.
#
# Hosting (Replit): add ONE secret, VISIONSWAP_CONFIG. Its value is the long line in
# keys/REPLIT-SECRETS.txt, written for you by 2-GO-LIVE-MAINNET. It already holds every
# setting listed further down, so nothing else is needed.
VISIONSWAP_CONFIG=

# Running the server yourself instead: copy this file to .env and set the lines below
# one by one (anything set individually wins over VISIONSWAP_CONFIG).
#
# NETWORK=mainnet
# A private RPC URL (Helius, Triton, QuickNode...). The public endpoint works but is slow and rate-limited.
# RPC_URL=
# Optional: a separate mainnet RPC for the exposure check (defaults to RPC_URL on mainnet)
# EXPOSURE_RPC_URL=
# PROGRAM_ID=
# RELAYER_SECRET=
# GUARD_SECRET=
# Your public site address, e.g. https://visionswap.xyz (link previews follow the visitor's address without it)
# PUBLIC_ORIGIN=
# Strongly recommended: a free key from portal.jup.ag (60 Jupiter calls a minute instead of 30)
# JUPITER_API_KEY=
# A paid Jupiter plan: its calls per minute (the server also learns a bigger plan by itself, up to JUPITER_RPM_MAX)
# JUPITER_RPM=
# JUPITER_RPM_MAX=600
# Optional
# RANGE_API_KEY=
# CONTACT_EMAIL=
# Where the source is published, e.g. https://github.com/you/visionswap
# REPO_URL=
# Optional extra swap fee on private sells (their SOL already pays the pool fee on the way back in)
# SELL_SWAP_FEE_BPS=0
# BLOCKED_COUNTRIES=CU,IR,KP,SY,AE
# How many of the host's own public proxies stand in front of the server (Replit: 1; "off" for none)
# TRUST_PROXY_HOPS=1
# Browser RPC calls a second the site passes on, for all visitors together (5 on Helius's free plan)
# RPC_PROXY_PER_SECOND=30
# /api/health reports the relayer as needing SOL below this (lamports, or SOL like 0.02)
# RELAYER_MIN_LAMPORTS=20000000
# Optional: any long random text. /api/health?token=<it> (or an x-health-token header) then also shows
# the operator details: Jupiter use, prices, orders and scheduled payments waiting. Keep it private.
# HEALTH_TOKEN=
# Where orders and scheduled payments are kept: auto (Replit App Storage on Replit, this machine's disk
# elsewhere) or disk. With disk, a published site doesn't ask for App Storage, but a publish starts empty.
# STATE_STORE=auto
# Extra addresses to refuse as depositors, senders or recipients, on top of the sanctions list (comma separated)
# BLOCKED_ADDRESSES=
# The $VSWAP token's mint address, shown on the Tokenomics page
# TOKEN_MINT=
# Below these balances (in lamports, or SOL like 0.05) /api/health shows a warning and the log says so once
# RELAYER_LOW_LAMPORTS=50000000
# GUARD_LOW_LAMPORTS=5000000
# Orders (take-profit, stop-loss, limit buys, DCA): the smallest new orders the server takes.
# Sells in USD at today's price; buys in lamports or SOL with a decimal point; the DCA interval in seconds.
# The app reads them from /api/orders/limits; keep the DCA buy at or below what the app allows (0.005).
# ORDER_MIN_SELL_USD=2
# ORDER_MIN_BUY_LAMPORTS=0.02
# ORDER_MIN_DCA_BUY_LAMPORTS=0.005
# ORDER_MIN_DCA_EVERY=3600
# Orders described but not started yet: per visitor and in all
# ORDERS_PENDING_PER_IP=5
# ORDERS_PENDING_MAX=2000
# Orders the app hands back after the server lost them, per visitor per 10 minutes
# ORDERS_RESUMES_PER_IP=20
# Order trades built at once (1-8; by default from the Jupiter plan: about 3 on a free key)
# KEEPER_WORKERS=
# Priority fee for order trades (micro-lamports per compute unit, defaults to PRIORITY_MICROLAMPORTS);
# stop-losses pay this many times more, never past the cap
# KEEPER_PRIORITY_MICROLAMPORTS=20000
# KEEPER_STOP_PRIORITY_X=4
# KEEPER_MAX_PRIORITY_MICROLAMPORTS=200000
# Order trades wait while the relayer holds less than this (lamports or SOL; defaults to RELAYER_LOW_LAMPORTS),
# so private sends always have SOL
# KEEPER_RELAYER_FLOOR_LAMPORTS=
# Payments to outside addresses arrive as a standard SOL transfer from a one-time sending address.
# Those sent while the page is closed (send later, split payments) go out on the relayer's durable
# nonces: "off" stops offering those choices (payments sent now are delivered either way).
# The nonce authority is derived from RELAYER_SECRET and holds no SOL: a new relayer key means
# scheduled payments signed for the old one turn stale, and the owner's app signs them again (the
# old nonce accounts stay on-chain; only the old key can close them).
# DELIVERY_NONCE=on
# Nonce accounts kept ready (about 0.00145 SOL of rent each, paid by the relayer), and the most there may be.
# After hours with far more ready than needed, the extra ones are closed and their rent comes back.
# NONCE_POOL_MIN=32
# NONCE_POOL_MAX=6000
